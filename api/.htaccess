# Block direct web access to the AI prompt, config and shared helper files.
# PHP can still read them from disk.
<FilesMatch "^(system-prompt\.(txt|php)|config\.php|config\.example\.php|_bootstrap\.php)$">
    Require all denied
</FilesMatch>

# Never cache API responses.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
</IfModule>
